# Runtime: use your OpenBox Core endpoint and OpenAI key.
OPENBOX_API_URL=https://core.openbox.ai
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
DOCUMENT_LIBRARY_DIR=./documents
REPORT_OUTPUT_DIR=./output
FILED_DOCUMENTS_DIR=./filed_documents
OPENBOX_VALIDATE=true

# Optional ports
# DEMO_UI_PORT=3000
# DEMO_API_PORT=8000

# IAM v3: use each agent's own PKCS8 PEM RSA workload key.
# Double-quoted values can contain \n escapes, for example:
# AMY_OPENBOX_WORKLOAD_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Supply PEM contents, not a path. Shared SDK auth variables are ignored by workers.
# Leave the workload key blank for API-key-only or legacy DID authentication.

# Amy
AMY_OPENBOX_AGENT_NAME=AmyClientIntelligenceAgent
AMY_OPENBOX_API_KEY=
AMY_OPENBOX_WORKLOAD_PRIVATE_KEY=
# Optional legacy DID signing: set both fields together.
# AMY_OPENBOX_AGENT_DID=
# AMY_OPENBOX_AGENT_PRIVATE_KEY=

# Barry
BARRY_OPENBOX_AGENT_NAME=BarryClientIntelligenceAgent
BARRY_OPENBOX_API_KEY=
BARRY_OPENBOX_WORKLOAD_PRIVATE_KEY=
# BARRY_OPENBOX_AGENT_DID=
# BARRY_OPENBOX_AGENT_PRIVATE_KEY=

# Colin
COLIN_OPENBOX_AGENT_NAME=ColinClientIntelligenceAgent
COLIN_OPENBOX_API_KEY=
COLIN_OPENBOX_WORKLOAD_PRIVATE_KEY=
# COLIN_OPENBOX_AGENT_DID=
# COLIN_OPENBOX_AGENT_PRIVATE_KEY=
